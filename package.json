{
  "name": "anchor-code",
  "version": "0.1.27",
  "description": "A human-in-the-loop reader for agent coding. Agent it. Review it. Feed it back.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src --exclude \"mobile/**\"",
    "test:integration": "vitest run electron",
    "test:watch": "vitest",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "ensure:pty": "node scripts/ensure-node-pty.js",
    "ensure:wsl-rg": "node scripts/ensure-wsl-rg.js",
    "postinstall": "node scripts/ensure-node-pty.js && node scripts/ensure-wsl-rg.js",
    "pack:win": "npm run build && electron-builder --win --x64 --publish never",
    "pack:win:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "pack:mac": "npm run build && electron-builder --mac --publish never",
    "pack:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "pack": "npm run build && electron-builder --publish never",
    "icons": "node scripts/generate-icons.mjs",
    "mobile:web": "npm --prefix mobile/web run build",
    "mobile:typecheck": "npm --prefix mobile/web run typecheck",
    "test:mobile": "vitest run mobile/web/src",
    "mobile:e2e": "npm --prefix mobile/web run e2e",
    "mobile:baseline": "npm run mobile:typecheck && npm run test:mobile && npm run mobile:e2e",
    "mobile:apk": "npm run mobile:web && bash mobile/android/build-apk.sh",
    "mobile:preview": "vite --config mobile/web/vite.config.ts --host 0.0.0.0 --port 5174"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.roboaholic.anchor-code",
    "productName": "Anchor Code",
    "copyright": "Copyright © Roboaholic",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@vscode/ripgrep/**",
      "node_modules/@vscode/ripgrep-*/**",
      "vendor/ripgrep-linux-*/**"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/rg",
          "**/*"
        ]
      },
      {
        "from": "skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Roboaholic",
        "repo": "anchor-code"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Anchor.Code-${version}-${os}-${arch}.${ext}",
      "executableName": "Anchor Code",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Anchor Code"
    },
    "portable": {
      "artifactName": "Anchor.Code-${version}-${os}-${arch}-portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Anchor.Code-${version}-${os}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "icon": "build/icon.icns"
    },
    "dmg": {
      "artifactName": "Anchor.Code-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Anchor.Code-${version}-${os}-${arch}.${ext}",
      "maintainer": "Roboaholic",
      "icon": "build/icons"
    },
    "icon": "build/icon.png"
  }
}
